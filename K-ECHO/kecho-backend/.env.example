DATABASE_URL=postgresql://localhost:5432/kecho

# Set one of these for higher-quality translation; with neither, the local offline model is used.
OPENAI_API_KEY=
DEEPL_API_KEY=

# Optional
# KECHO_TRANSLATOR=openai|deepl|local|none
# KECHO_OPENAI_MODEL=gpt-4o-mini

# Optional legacy batch discovery uses the YouTube Data API v3, never the search API.
YOUTUBE_API_KEY=
# Optional comma-separated override of the official channel allowlist (see pipeline.py)
# KECHO_OFFICIAL_CHANNELS=tvN DRAMA,KBS Drama Classic

KECHO_CORS_ORIGINS=https://www.daynize.co.kr,https://daynize.co.kr
