  "scenes": [
    {
      "id": "concept-1",
      "kind": "concept",
      "start": 0,
      "end": 10,
      "text": "즐기다, 피하다, 끝내다 뒤의 행동은 아이엔지로 묶어요. 꺼리다는 표현도 같지만 결정하다는 투와 원형을 써요.",
      "screen": "enjoy / avoid / finish / mind + doing; decide + to do",
      "visual": "네 동사를 doing 열에, decide를 to do 열에 놓고 선택표 만들기.",
      "narration": [
        {
          "id": "concept-1-ko",
          "lang": "ko",
          "voice": "Minsu (Enhanced)",
          "text": "즐기다, 피하다, 끝내다 뒤의 행동은 아이엔지로 묶어요. 꺼리다는 표현도 같지만 결정하다는 투와 원형을 써요.",
          "actualStart": null,
          "actualEnd": null
        }
      ]
    },
    {
      "id": "concept-2",
      "kind": "concept",
      "start": 10,
      "end": 20,
      "text": "스톱 뒤의 아이엔지는 하던 행동을 멈춘다는 뜻이에요. 투와 원형은 다른 행동을 하려고 멈췄다는 목적이죠.",
      "screen": "stop talking / stop to talk",
      "visual": "대화 중단 시간선과 이동을 멈추고 대화 시작하는 시간선을 대비.",
      "narration": [
        {
          "id": "concept-2-ko",
          "lang": "ko",
          "voice": "Minsu (Enhanced)",
          "text": "스톱 뒤의 아이엔지는 하던 행동을 멈춘다는 뜻이에요. 투와 원형은 다른 행동을 하려고 멈췄다는 목적이죠.",
          "actualStart": null,
          "actualEnd": null
        }
      ]
    },
    {
      "id": "concept-3",
      "kind": "concept",
      "start": 20,
      "end": 30,
      "text": "리멤버 뒤의 아이엔지는 이미 한 일을 기억하는 뜻이에요. 투와 원형은 해야 할 일을 잊지 않고 한다는 뜻이죠.",
      "screen": "remember locking / remember to lock",
      "visual": "잠금 행동 뒤 회상과 기억 뒤 잠금 행동의 순서를 반대로 배치.",
      "narration": [
        {
          "id": "concept-3-ko",
          "lang": "ko",
          "voice": "Minsu (Enhanced)",
          "text": "리멤버 뒤의 아이엔지는 이미 한 일을 기억하는 뜻이에요. 투와 원형은 해야 할 일을 잊지 않고 한다는 뜻이죠.",
          "actualStart": null,
          "actualEnd": null
        }
      ]
    },
    {
      "id": "concept-4",
      "kind": "contrast",
      "start": 30,
      "end": 40,
      "text": "트라이 뒤의 아이엔지는 방법을 시험해 보는 쪽에, 투와 원형은 해내려 노력하는 쪽에 초점을 두는 경우가 많아요.",
      "screen": "try restarting / try to repair",
      "visual": "재시작 방법 시험 카드와 수리 목표 노력 화살표를 나란히 표시.",
      "narration": [
        {
          "id": "concept-4-ko",
          "lang": "ko",
          "voice": "Minsu (Enhanced)",
          "text": "트라이 뒤의 아이엔지는 방법을 시험해 보는 쪽에, 투와 원형은 해내려 노력하는 쪽에 초점을 두는 경우가 많아요.",
          "actualStart": null,
          "actualEnd": null
        }
