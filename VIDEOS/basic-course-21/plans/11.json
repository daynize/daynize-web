  "scenes": [
    {
      "id": "concept-1",
      "kind": "concept",
      "start": 0,
      "end": 10,
      "text": "나는 가고 싶다에서는 내가 가요. 나는 네가 가기를 바란다에서는 네가 가죠. 행동 주체를 따로 밝혀야 해요.",
      "screen": "I want to go. / I want you to go.",
      "visual": "각 문장에서 go로 향하는 화살표를 I와 you에 각각 연결.",
      "narration": [
        {
          "id": "concept-1-ko",
          "lang": "ko",
          "voice": "Jian (Premium)",
          "text": "나는 가고 싶다에서는 내가 가요. 나는 네가 가기를 바란다에서는 네가 가죠. 행동 주체를 따로 밝혀야 해요.",
          "actualStart": null,
          "actualEnd": null
        }
      ]
    },
    {
      "id": "concept-2",
      "kind": "concept",
      "start": 10,
      "end": 20,
      "text": "원하다, 부탁하다, 허락하다 같은 동사는 사람 뒤에 투와 원형을 붙여요. 그 사람이 뒤의 행동을 하는 구조예요.",
      "screen": "want / ask / allow + 사람 + to do",
      "visual": "동사 → 사람 → to do 배열에서 사람이 행동 주체임을 아래 화살표로 표시.",
      "narration": [
        {
          "id": "concept-2-ko",
          "lang": "ko",
          "voice": "Jian (Premium)",
          "text": "원하다, 부탁하다, 허락하다 같은 동사는 사람 뒤에 투와 원형을 붙여요. 그 사람이 뒤의 행동을 하는 구조예요.",
          "actualStart": null,
          "actualEnd": null
        }
      ]
    },
    {
      "id": "concept-3",
      "kind": "concept",
      "start": 20,
      "end": 30,
      "text": "가능하게 하다, 격려하다, 경고하다도 이런 결합을 쓸 수 있어요. 시키는 말이라고 원형만 붙이지 마세요.",
      "screen": "enable / encourage / warn + 사람 + to do",
      "visual": "세 동사의 가능·격려·경고 표지를 구분하고 공통 to 연결 칸 강조.",
      "narration": [
        {
          "id": "concept-3-ko",
          "lang": "ko",
          "voice": "Jian (Premium)",
          "text": "가능하게 하다, 격려하다, 경고하다도 이런 결합을 쓸 수 있어요. 시키는 말이라고 원형만 붙이지 마세요.",
          "actualStart": null,
          "actualEnd": null
        }
      ]
    },
    {
      "id": "concept-4",
      "kind": "contrast",
      "start": 30,
      "end": 40,
      "text": "하지 말라고 할 때는 투 앞에 낫을 놓아요. 다만 모든 동사가 이 구조를 받지는 않으니 동사별로 익혀야 해요.",
      "screen": "ask someone not to do / warn someone not to do",
      "visual": "not을 to do 묶음 앞에 배치하고 행동 금지 범위 괄호 표시.",
      "narration": [
