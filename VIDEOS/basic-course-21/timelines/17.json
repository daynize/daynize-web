{
  "id": "basic-17",
  "episode": 17,
  "title": "두 문장을 명사 하나로 연결하기",
  "durationTarget": 130,
  "timingStatus": "audio-measured-words-aligned",
  "voices": {
    "ko": "Jian (Premium)",
