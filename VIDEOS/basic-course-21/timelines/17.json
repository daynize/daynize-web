  "scenes": [
    {
      "id": "concept-1",
      "kind": "concept",
      "start": 0,
      "end": 9.455576200000001,
      "text": "같은 사람이나 사물을 말하는 두 문장은 관계절로 연결할 수 있어요. 겹치는 자리를 먼저 찾으세요.",
      "screen": "The woman helped me. / The woman lives nearby.",
      "visual": "첫 예문을 두 문장으로 펼치고 공통 명사를 연결.",
      "narration": [
        {
          "id": "concept-1-ko",
          "lang": "ko",
          "voice": "Jian (Premium)",
          "text": "같은 사람이나 사물을 말하는 두 문장은 관계절로 연결할 수 있어요. 겹치는 자리를 먼저 찾으세요.",
          "actualStart": 0.2,
          "actualEnd": 7.297868,
          "rate": 185,
          "cacheKey": "5d1c5d98b93965080bdd2924160af221b6542900f0203ac5c01425a27c6734c8",
          "file": "audio/17/concept-1-ko-5d1c5d98b9396508.wav",
          "duration": 7.097868
        }
      ],
      "plannedStart": 0,
      "plannedEnd": 10
    },
    {
      "id": "concept-2",
      "kind": "concept",
      "start": 9.455576200000001,
      "end": 19.018001400000003,
      "text": "관계대명사가 주어 역할이면 뒤에 주어를 또 넣지 않아요. 사람은 후, 사물은 위치로 연결할 수 있죠.",
      "screen": "who helped me / 주어 자리",
      "visual": "첫 예문의 who에서 helped로 연결하고 중복 주어 칸 제거.",
      "narration": [
        {
          "id": "concept-2-ko",
          "lang": "ko",
          "voice": "Jian (Premium)",
          "text": "관계대명사가 주어 역할이면 뒤에 주어를 또 넣지 않아요. 사람은 후, 사물은 위치로 연결할 수 있죠.",
          "actualStart": 9.6555762,
          "actualEnd": 16.8602932,
          "rate": 185,
          "cacheKey": "8fc910f5cce1b5031f77f5e85aa95cb36934d9952eea15d033e0750314b8e599",
          "file": "audio/17/concept-2-ko-8fc910f5cce1b503.wav",
          "duration": 7.204717
        }
      ],
      "plannedStart": 10,
      "plannedEnd": 20
    },
    {
      "id": "concept-3",
      "kind": "concept",
      "start": 19.018001400000003,
      "end": 29.059836600000004,
      "text": "목적어 역할이면 관계절 안에 주어가 따로 있어요. 명사를 좁혀 주는 목적격 관계대명사는 생략할 수 있죠.",
      "screen": "관계절: 주어 + 동사 + 목적어 빈칸",
      "visual": "주격과 목적격의 빈자리 위치를 두 줄로 비교.",
      "narration": [
        {
          "id": "concept-3-ko",
          "lang": "ko",
          "voice": "Jian (Premium)",
          "text": "목적어 역할이면 관계절 안에 주어가 따로 있어요. 명사를 좁혀 주는 목적격 관계대명사는 생략할 수 있죠.",
          "actualStart": 19.218001400000002,
          "actualEnd": 26.902128400000002,
          "rate": 185,
          "cacheKey": "0e4bf6aa32d388c00a139c43c3661696ea6b01e0996ea9d87f35b0a173fd8817",
          "file": "audio/17/concept-3-ko-0e4bf6aa32d388c0.wav",
          "duration": 7.684127
        }
      ],
      "plannedStart": 20,
      "plannedEnd": 30
    },
    {
      "id": "concept-4",
      "kind": "contrast",
      "start": 29.059836600000004,
      "end": 38.877408800000005,
      "text": "주격은 보통 생략할 수 없어요. 쉼표로 덧붙이는 관계절에는 댓을 쓰거나 관계대명사를 빼지 마세요.",
      "screen": "주격 생략 금지 / 쉼표 뒤 that 금지",
      "visual": "제한적 관계절과 쉼표로 분리된 추가 설명을 다른 선으로 표시.",
      "narration": [
        {
