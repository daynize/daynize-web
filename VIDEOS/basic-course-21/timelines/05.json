  "scenes": [
    {
      "id": "concept-1",
      "kind": "concept",
      "start": 0,
      "end": 9.459241533333334,
      "text": "누군가에게 일을 하게 할 때, 사람 뒤의 동사 형태를 확인하세요. 메이크와 렛 뒤에서는 원형을 써요.",
      "screen": "make / let + 사람 + 동사원형",
      "visual": "make와 let 두 줄에서 사람 칸 다음 원형 칸을 같은 색으로 강조.",
      "narration": [
        {
          "id": "concept-1-ko",
          "lang": "ko",
          "voice": "Jian (Premium)",
          "text": "누군가에게 일을 하게 할 때, 사람 뒤의 동사 형태를 확인하세요. 메이크와 렛 뒤에서는 원형을 써요.",
          "actualStart": 0.2,
          "actualEnd": 7.199048,
          "rate": 185,
          "cacheKey": "d9804f7bbb8e6a9bc2cb099487ef9d2f838c87ac1c45207f0151bec7a19dc35a",
          "file": "audio/05/concept-1-ko-d9804f7bbb8e6a9b.wav",
          "duration": 6.999048
        }
      ],
      "plannedStart": 0,
      "plannedEnd": 10
    },
    {
      "id": "concept-2",
      "kind": "concept",
      "start": 9.459241533333334,
      "end": 18.721158066666668,
      "text": "일을 맡기는 해브도 사람 뒤에 원형을 쓰지만, 겟으로 누군가 하도록 이끌면 투와 원형을 붙여요.",
      "screen": "have someone do / get someone to do",
      "visual": "have와 get 평행 배열에서 get 줄에만 to 연결 고리 표시.",
      "narration": [
        {
          "id": "concept-2-ko",
          "lang": "ko",
          "voice": "Jian (Premium)",
          "text": "일을 맡기는 해브도 사람 뒤에 원형을 쓰지만, 겟으로 누군가 하도록 이끌면 투와 원형을 붙여요.",
          "actualStart": 9.659241533333333,
          "actualEnd": 16.460964533333332,
          "rate": 185,
          "cacheKey": "32b9e80fc0f4e6593d26f375c9dbfee85814a7de6389443ecc7945de5bdfd2e6",
          "file": "audio/05/concept-2-ko-32b9e80fc0f4e659.wav",
          "duration": 6.801723
        }
      ],
      "plannedStart": 10,
      "plannedEnd": 20
    },
    {
      "id": "concept-3",
      "kind": "concept",
      "start": 18.721158066666668,
      "end": 28.274911600000003,
      "text": "보고 듣는 표현에서도 사람 뒤에 원형이 올 수 있어요. 동작 전체를 보았다는 관점에서 자주 쓰죠.",
      "screen": "see / hear + 사람 + 동사원형",
      "visual": "한 동작의 시작부터 끝까지 이어진 전체 구간을 눈·귀 표시로 묶기.",
      "narration": [
        {
          "id": "concept-3-ko",
          "lang": "ko",
          "voice": "Jian (Premium)",
          "text": "보고 듣는 표현에서도 사람 뒤에 원형이 올 수 있어요. 동작 전체를 보았다는 관점에서 자주 쓰죠.",
          "actualStart": 18.921158066666667,
          "actualEnd": 26.014718066666667,
          "rate": 185,
          "cacheKey": "5022cd4fca55a3b5b16f3899a540b3133b66d815468450870bb86ec00175b37a",
          "file": "audio/05/concept-3-ko-5022cd4fca55a3b5.wav",
