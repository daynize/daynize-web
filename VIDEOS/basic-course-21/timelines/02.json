  "scenes": [
    {
      "id": "concept-1",
      "kind": "concept",
      "start": 0,
      "end": 10.126255733333334,
      "text": "나는 앉았다. 여기까지는 문장이 완성돼요. 그런데 의자에 앉았다고 말하고 싶다면, 의자를 어떻게 연결할까요?",
      "screen": "동작 / 장소",
      "visual": "앉는 인물과 의자를 두 부분으로 분리.",
      "narration": [
        {
          "id": "concept-1-ko",
          "lang": "ko",
          "voice": "Minsu (Enhanced)",
          "text": "나는 앉았다. 여기까지는 문장이 완성돼요. 그런데 의자에 앉았다고 말하고 싶다면, 의자를 어떻게 연결할까요?",
          "actualStart": 0.2,
          "actualEnd": 8.34898,
          "rate": 185,
          "cacheKey": "9ead1d6c2d1c4b38ea549708c40090d37cbb7b79943a6d43023e3caec0fd5782",
          "file": "audio/02/concept-1-ko-9ead1d6c2d1c4b38.wav",
          "duration": 8.14898
        }
      ],
      "plannedStart": 0,
      "plannedEnd": 10
    },
    {
      "id": "concept-2",
      "kind": "concept",
      "start": 10.126255733333334,
      "end": 21.11174046666667,
      "text": "의자를 동사 바로 뒤에 붙이지 않아요. 의자 위라는 관계를 나타내는 전치사가 필요하죠. 이때 전치사는 연결을 돕는 지팡이예요.",
      "screen": "❌ I sat the chair by the window. / ⭕ I sat on the chair by the window.",
      "visual": "첫 예문의 on이 인물과 의자를 연결.",
      "narration": [
        {
          "id": "concept-2-ko",
          "lang": "ko",
          "voice": "Minsu (Enhanced)",
          "text": "의자를 동사 바로 뒤에 붙이지 않아요. 의자 위라는 관계를 나타내는 전치사가 필요하죠. 이때 전치사는 연결을 돕는 지팡이예요.",
          "actualStart": 10.326255733333333,
          "actualEnd": 19.334464733333334,
          "rate": 185,
          "cacheKey": "1512f185e4a2836e8c3e6c6af99fb1a64a2c4da95af56ddc0dd09615d8250d91",
          "file": "audio/02/concept-2-ko-1512f185e4a2836e.wav",
          "duration": 9.008209
        }
      ],
      "plannedStart": 10,
      "plannedEnd": 20
    },
    {
      "id": "concept-3",
      "kind": "concept",
      "start": 21.11174046666667,
      "end": 31.706250200000003,
      "text": "전치사 뒤의 명사는 동사의 직접 목적어가 아니에요. 동사와 전치사를 함께 보고, 어떤 관계를 나타내는지 이해하세요.",
      "screen": "I / sat / on the chair",
      "visual": "chair는 on의 목적어라고 표시하고 동사의 직접 목적어와 구분.",
      "narration": [
        {
          "id": "concept-3-ko",
          "lang": "ko",
          "voice": "Minsu (Enhanced)",
          "text": "전치사 뒤의 명사는 동사의 직접 목적어가 아니에요. 동사와 전치사를 함께 보고, 어떤 관계를 나타내는지 이해하세요.",
          "actualStart": 21.31174046666667,
          "actualEnd": 29.92897446666667,
          "rate": 185,
          "cacheKey": "9fc88c690ddde5f50df1bffe7973c2d3206b0857155e9c6353f6bf0bd765e768",
          "file": "audio/02/concept-3-ko-9fc88c690ddde5f5.wav",
          "duration": 8.617234
        }
      ],
      "plannedStart": 20,
      "plannedEnd": 30
    },
    {
      "id": "concept-4",
      "kind": "contrast",
      "start": 31.706250200000003,
      "end": 43.450146933333336,
      "text": "전치사는 아무거나 붙일 수 없어요. 기다리는 대상은 포, 귀 기울이는 대상은 투로 연결하죠. 동사와 전치사의 조합을 예문으로 익혀 봅시다.",
      "screen": "wait + for / listen + to",
      "visual": "대기·듣기 동작과 대상 연결. 영어 예문 별도 발화 없음.",
      "narration": [
        {
          "id": "concept-4-ko",
          "lang": "ko",
          "voice": "Minsu (Enhanced)",
          "text": "전치사는 아무거나 붙일 수 없어요. 기다리는 대상은 포, 귀 기울이는 대상은 투로 연결하죠. 동사와 전치사의 조합을 예문으로 익혀 봅시다.",
          "actualStart": 31.906250200000002,
          "actualEnd": 41.6728712,
          "rate": 185,
          "cacheKey": "57943f0e3b1c9463a00f1e3d7725e50c71e2ef10f8eb8814f5f91fafdaeba351",
