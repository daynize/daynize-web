  "scenes": [
    {
      "id": "concept-1",
      "kind": "concept",
      "start": 0,
      "end": 10.452553466666668,
      "text": "현재완료는 과거의 일을 지금과 연결해서 말해요. 경험이 있거나, 결과가 남거나, 지금까지 이어지는 경우죠.",
      "screen": "과거 → 지금 / have·has + 과거분사",
      "visual": "과거 사건에서 현재까지 연결된 시간선에 경험·결과·지속 세 갈래 표시.",
      "narration": [
        {
          "id": "concept-1-ko",
          "lang": "ko",
          "voice": "Jian (Premium)",
          "text": "현재완료는 과거의 일을 지금과 연결해서 말해요. 경험이 있거나, 결과가 남거나, 지금까지 이어지는 경우죠.",
          "actualStart": 0.2,
          "actualEnd": 8.451701,
          "rate": 185,
          "cacheKey": "c738a768888aa19f9fd11dd8cf9699ae8b477cc28f30b3b249552c33371b3a60",
          "file": "audio/07/concept-1-ko-c738a768888aa19f.wav",
          "duration": 8.251701
        }
      ],
      "plannedStart": 0,
      "plannedEnd": 10
    },
    {
      "id": "concept-2",
      "kind": "concept",
      "start": 10.452553466666668,
      "end": 21.147645933333333,
      "text": "가 본 적이 있는지, 벌써 끝냈는지, 아직 안 했는지 말할 때 자주 써요. 에버, 올레디, 옛이 단서가 되죠.",
      "screen": "ever / already / yet",
      "visual": "경험 목록·완료 체크·미완료 체크에 세 단어를 각각 붙이기.",
      "narration": [
        {
          "id": "concept-2-ko",
          "lang": "ko",
          "voice": "Jian (Premium)",
          "text": "가 본 적이 있는지, 벌써 끝냈는지, 아직 안 했는지 말할 때 자주 써요. 에버, 올레디, 옛이 단서가 되죠.",
          "actualStart": 10.652553466666667,
          "actualEnd": 19.146793466666665,
          "rate": 185,
          "cacheKey": "551f525933e2ef221fe94c1d4586c31890d267408fffa7c0eb4e15d07a7385d8",
          "file": "audio/07/concept-2-ko-551f525933e2ef22.wav",
          "duration": 8.49424
        }
      ],
      "plannedStart": 10,
      "plannedEnd": 20
    },
    {
      "id": "concept-3",
      "kind": "concept",
      "start": 21.147645933333333,
      "end": 31.4438724,
      "text": "지금까지 이어지는 일은 시작점을 신스로, 기간을 포로 연결해요. 갔다 온 경험과 가서 없는 상태도 구분해요.",
      "screen": "since Monday / for three days / been·gone",
      "visual": "시작점과 길이 괄호를 분리하고 been은 왕복, gone은 현재 부재로 표시.",
      "narration": [
        {
          "id": "concept-3-ko",
          "lang": "ko",
          "voice": "Jian (Premium)",
          "text": "지금까지 이어지는 일은 시작점을 신스로, 기간을 포로 연결해요. 갔다 온 경험과 가서 없는 상태도 구분해요.",
          "actualStart": 21.347645933333332,
          "actualEnd": 29.443019933333332,
          "rate": 185,
          "cacheKey": "ae77edcd017255a80e4f9e95c52c92cd0e0ca344a448c6cd86a46d71b0d878b0",
          "file": "audio/07/concept-3-ko-ae77edcd017255a8.wav",
          "duration": 8.095374
        }
      ],
      "plannedStart": 20,
      "plannedEnd": 30
    },
    {
      "id": "concept-4",
      "kind": "contrast",
      "start": 31.4438724,
      "end": 42.17279786666667,
      "text": "어제처럼 끝난 과거 시점을 지정하면 보통 과거형을 써요. 현재완료의 해브 뒤에는 동사 원형이 아니라 과거분사예요.",
      "screen": "yesterday → 과거형 / have finished",
      "visual": "닫힌 yesterday 구간과 현재 연결선을 대비하고 finished 형태를 확대.",
      "narration": [
        {
          "id": "concept-4-ko",
          "lang": "ko",
