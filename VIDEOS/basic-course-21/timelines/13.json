  "scenes": [
    {
      "id": "concept-1",
      "kind": "concept",
      "start": 0,
      "end": 9.745302933333335,
      "text": "분사는 명사의 모습이나 상태를 설명해요. 잠자는 아이처럼, 그 대상이 직접 하는 일을 나타낼 수 있죠.",
      "screen": "a sleeping child / 아이가 잠자는 중",
      "visual": "첫 예문의 아이에서 sleeping으로 능동 화살표 연결.",
      "narration": [
        {
          "id": "concept-1-ko",
          "lang": "ko",
          "voice": "Jian (Premium)",
          "text": "분사는 명사의 모습이나 상태를 설명해요. 잠자는 아이처럼, 그 대상이 직접 하는 일을 나타낼 수 있죠.",
          "actualStart": 0.2,
          "actualEnd": 7.567256,
          "rate": 185,
          "cacheKey": "0365df517bdc917d8a159d374bce0fb36f71c2755db4265e2db2bb8fb9761d3b",
          "file": "audio/13/concept-1-ko-0365df517bdc917d.wav",
          "duration": 7.367256
        }
      ],
      "plannedStart": 0,
      "plannedEnd": 10
    },
    {
      "id": "concept-2",
      "kind": "concept",
      "start": 9.745302933333335,
      "end": 19.075639866666666,
      "text": "현재분사는 보통 직접 하는 동작을, 과거분사는 받은 작용이나 결과 상태를 보여 줘요.",
      "screen": "하는 대상 / 작용을 받은 대상",
      "visual": "아이의 동작과 깨진 창문의 결과를 두 열로 대조.",
      "narration": [
        {
          "id": "concept-2-ko",
          "lang": "ko",
          "voice": "Jian (Premium)",
          "text": "현재분사는 보통 직접 하는 동작을, 과거분사는 받은 작용이나 결과 상태를 보여 줘요.",
          "actualStart": 9.945302933333334,
          "actualEnd": 16.897592933333335,
          "rate": 185,
          "cacheKey": "a920faa3f0d5fc393f5a1e6f92c61e160d8e6c240970bba16f741990460afde8",
          "file": "audio/13/concept-2-ko-a920faa3f0d5fc39.wav",
          "duration": 6.95229
        }
      ],
      "plannedStart": 10,
      "plannedEnd": 20
    },
    {
      "id": "concept-3",
      "kind": "concept",
      "start": 19.075639866666666,
      "end": 28.1730068,
      "text": "과거분사는 모두 이디로 끝나지 않아요. 깨진 창문의 브로큰처럼 불규칙 형태도 익혀야 해요.",
      "screen": "break → broke → broken",
      "visual": "원형·과거형·과거분사 세 칸에서 broken만 명사에 연결.",
      "narration": [
        {
          "id": "concept-3-ko",
          "lang": "ko",
          "voice": "Jian (Premium)",
          "text": "과거분사는 모두 이디로 끝나지 않아요. 깨진 창문의 브로큰처럼 불규칙 형태도 익혀야 해요.",
          "actualStart": 19.275639866666666,
          "actualEnd": 25.994959866666665,
          "rate": 185,
          "cacheKey": "4b83c5e47a082f029d3bd04d98bed602f926b014908e0945bc681504b9a61fff",
          "file": "audio/13/concept-3-ko-4b83c5e47a082f02.wav",
          "duration": 6.71932
        }
      ],
      "plannedStart": 20,
      "plannedEnd": 30
    },
    {
      "id": "concept-4",
      "kind": "contrast",
      "start": 28.1730068,
      "end": 38.23177973333333,
      "text": "분사의 이름만 보고 현재와 과거를 결정하지 마세요. 명사와의 관계를 보고, 완료된 상태도 구분하세요.",
      "screen": "시간 이름보다 명사와의 관계",
      "visual": "첫 두 예문의 sleeping과 broken을 각각 동작·결과 상태에 연결.",
      "narration": [
        {
