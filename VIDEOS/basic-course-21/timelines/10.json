{
  "id": "basic-10",
  "episode": 10,
  "title": "먹을 것과 먹으러 가는 이유",
  "durationTarget": 130,
  "timingStatus": "audio-measured-words-aligned",
  "voices": {
    "ko": "Minsu (Enhanced)",
