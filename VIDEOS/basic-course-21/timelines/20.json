  "scenes": [
    {
      "id": "concept-1",
      "kind": "concept",
      "start": 0,
      "end": 9.714497133333335,
      "text": "실제와 다른 상황을 가정할 때는 시간부터 나눠요. 지금 다른 상황인지, 이미 지난 일을 바꾸는지 보세요.",
      "screen": "지금의 반사실 / 과거의 반사실",
      "visual": "현재 지점과 지나간 지점을 두 시간선으로 분리.",
      "narration": [
        {
          "id": "concept-1-ko",
          "lang": "ko",
          "voice": "Minsu (Enhanced)",
          "text": "실제와 다른 상황을 가정할 때는 시간부터 나눠요. 지금 다른 상황인지, 이미 지난 일을 바꾸는지 보세요.",
          "actualStart": 0.2,
          "actualEnd": 7.766848,
          "rate": 185,
          "cacheKey": "353893fb3af226b51bed231c8e4193c2b1c866bc83057cdf150f9c5b79085827",
          "file": "audio/20/concept-1-ko-353893fb3af226b5.wav",
          "duration": 7.566848
        }
      ],
      "plannedStart": 0,
      "plannedEnd": 10
    },
    {
      "id": "concept-2",
      "kind": "concept",
      "start": 9.714497133333335,
      "end": 19.11040026666667,
      "text": "지금의 반사실은 이프절에 과거형을 써요. 결과는 우드와 원형으로 나타내며, 비동사는 워를 쓸 수 있죠.",
      "screen": "if + 과거형 / would + 원형",
      "visual": "첫 예문의 were와 would buy를 현재 가정 선에 연결.",
      "narration": [
        {
          "id": "concept-2-ko",
          "lang": "ko",
          "voice": "Minsu (Enhanced)",
          "text": "지금의 반사실은 이프절에 과거형을 써요. 결과는 우드와 원형으로 나타내며, 비동사는 워를 쓸 수 있죠.",
          "actualStart": 9.914497133333334,
          "actualEnd": 17.162751133333334,
          "rate": 185,
          "cacheKey": "490b05b65d2efd208dc3a9a8114d4c42186486baaf987cbe0d6bc50e00c609fe",
          "file": "audio/20/concept-2-ko-490b05b65d2efd20.wav",
          "duration": 7.248254
        }
      ],
      "plannedStart": 10,
      "plannedEnd": 20
    },
    {
      "id": "concept-3",
      "kind": "concept",
      "start": 19.11040026666667,
      "end": 27.921995400000004,
      "text": "지난 일의 반사실은 이프절에 해드와 과거분사를 써요. 결과도 우드 해브와 과거분사로 맞춥니다.",
      "screen": "if + had + 과거분사 / would have + 과거분사",
      "visual": "과거 원인과 실현되지 않은 과거 결과를 연결.",
      "narration": [
        {
          "id": "concept-3-ko",
          "lang": "ko",
          "voice": "Minsu (Enhanced)",
          "text": "지난 일의 반사실은 이프절에 해드와 과거분사를 써요. 결과도 우드 해브와 과거분사로 맞춥니다.",
          "actualStart": 19.31040026666667,
          "actualEnd": 25.974346266666668,
          "rate": 185,
          "cacheKey": "c2c8e851f1438e3df89e13032c502f0d6ce9b9d9a20cbf0fb796519d99078d8c",
          "file": "audio/20/concept-3-ko-c2c8e851f1438e3d.wav",
          "duration": 6.663946
        }
      ],
      "plannedStart": 20,
      "plannedEnd": 30
    },
    {
      "id": "concept-4",
      "kind": "contrast",
      "start": 27.921995400000004,
      "end": 36.93599353333334,
      "text": "쿠드는 할 수 있었을 가능성이나 능력을 나타내요. 우드와 뜻이 같지는 않으며, 문맥에 맞춰 고르세요.",
      "screen": "would: 예상 결과 / could: 능력·가능성",
      "visual": "결과 경로와 가능한 선택지 경로를 구분.",
      "narration": [
        {
          "id": "concept-4-ko",
          "lang": "ko",
          "voice": "Minsu (Enhanced)",
          "text": "쿠드는 할 수 있었을 가능성이나 능력을 나타내요. 우드와 뜻이 같지는 않으며, 문맥에 맞춰 고르세요.",
