  "scenes": [
    {
      "id": "concept-1",
      "kind": "concept",
      "start": 0,
      "end": 9.425550733333333,
      "text": "누군가의 이름이나 물건을 설명할 때는 소유 관계를 연결해요. 후즈 뒤에 그 소유 대상인 명사를 놓죠.",
      "screen": "사람 / whose + 소유 대상 명사",
      "visual": "첫 예문의 woman에서 son으로 소유 연결선 표시.",
      "narration": [
        {
          "id": "concept-1-ko",
          "lang": "ko",
          "voice": "Minsu (Enhanced)",
          "text": "누군가의 이름이나 물건을 설명할 때는 소유 관계를 연결해요. 후즈 뒤에 그 소유 대상인 명사를 놓죠.",
          "actualStart": 0.2,
          "actualEnd": 6.862222,
          "rate": 185,
          "cacheKey": "8a5b4f8989160c029443022116d9ac70edf91aac3361b6d20e514da5acbd5123",
          "file": "audio/18/concept-1-ko-8a5b4f8989160c02.wav",
          "duration": 6.662222
        }
      ],
      "plannedStart": 0,
      "plannedEnd": 10
    },
    {
      "id": "concept-2",
      "kind": "concept",
      "start": 9.425550733333333,
      "end": 18.46819946666667,
      "text": "후즈 자체가 누구의라는 연결을 맡아요. 뒤에 그의나 그녀의에 해당하는 소유어를 또 넣지 마세요.",
      "screen": "whose son / whose her son은 중복",
      "visual": "첫 예문의 son 앞에 소유 자리 하나만 남기는 도식.",
      "narration": [
        {
          "id": "concept-2-ko",
          "lang": "ko",
          "voice": "Minsu (Enhanced)",
          "text": "후즈 자체가 누구의라는 연결을 맡아요. 뒤에 그의나 그녀의에 해당하는 소유어를 또 넣지 마세요.",
          "actualStart": 9.625550733333332,
          "actualEnd": 15.904870733333333,
          "rate": 185,
          "cacheKey": "be0890555c3b02fca232eab8233df60bb8bd9ffc70190f6c3f06897671e84d25",
          "file": "audio/18/concept-2-ko-be0890555c3b02fc.wav",
          "duration": 6.27932
        }
      ],
      "plannedStart": 10,
      "plannedEnd": 20
    },
    {
      "id": "concept-3",
      "kind": "concept",
      "start": 18.46819946666667,
      "end": 28.649306200000005,
      "text": "왓은 무엇이라는 내용을 통째로 묶을 수 있어요. 앞에서 명사를 받고 꾸미는 일반 관계대명사와 달라요.",
      "screen": "what절 = ~하는 것",
      "visual": "what절 전체를 명사 자리 크기의 묶음으로 표시.",
      "narration": [
        {
          "id": "concept-3-ko",
          "lang": "ko",
          "voice": "Minsu (Enhanced)",
          "text": "왓은 무엇이라는 내용을 통째로 묶을 수 있어요. 앞에서 명사를 받고 꾸미는 일반 관계대명사와 달라요.",
          "actualStart": 18.668199466666668,
          "actualEnd": 26.08597746666667,
          "rate": 185,
          "cacheKey": "9a3157d3614176d5802821ce0b7bf4158a6c4aaa09b8114fc68e0b45b7e8b3a9",
          "file": "audio/18/concept-3-ko-9a3157d3614176d5.wav",
          "duration": 7.417778
        }
      ],
      "plannedStart": 20,
      "plannedEnd": 30
    },
    {
      "id": "concept-4",
      "kind": "contrast",
      "start": 28.649306200000005,
      "end": 39.00814493333334,
      "text": "관계절의 왓 앞에는 같은 뜻의 선행사 명사를 두지 않아요. 명사를 남기려면 댓이나 위치로 연결하세요.",
      "screen": "what / the thing that",
      "visual": "명사 포함 경로와 선행사 따로 두는 경로를 분리.",
      "narration": [
        {
          "id": "concept-4-ko",
          "lang": "ko",
