  "scenes": [
    {
      "id": "concept-1",
      "kind": "concept",
      "start": 0,
      "end": 10.4285746,
      "text": "즐기다, 피하다, 끝내다 뒤의 행동은 아이엔지로 묶어요. 꺼리다는 표현도 같지만 결정하다는 투와 원형을 써요.",
      "screen": "enjoy / avoid / finish / mind + doing; decide + to do",
      "visual": "네 동사를 doing 열에, decide를 to do 열에 놓고 선택표 만들기.",
      "narration": [
        {
          "id": "concept-1-ko",
          "lang": "ko",
          "voice": "Minsu (Enhanced)",
          "text": "즐기다, 피하다, 끝내다 뒤의 행동은 아이엔지로 묶어요. 꺼리다는 표현도 같지만 결정하다는 투와 원형을 써요.",
          "actualStart": 0.2,
          "actualEnd": 8.18127,
          "rate": 185,
          "cacheKey": "7f6d8f8e293662fb5d51c1a6766b9c9f6761178cb1c4e41ab247a5c6d9cb5239",
          "file": "audio/12/concept-1-ko-7f6d8f8e293662fb.wav",
          "duration": 7.98127
        }
      ],
      "plannedStart": 0,
      "plannedEnd": 10
    },
    {
      "id": "concept-2",
      "kind": "concept",
      "start": 10.4285746,
      "end": 20.3049952,
      "text": "스톱 뒤의 아이엔지는 하던 행동을 멈춘다는 뜻이에요. 투와 원형은 다른 행동을 하려고 멈췄다는 목적이죠.",
      "screen": "stop talking / stop to talk",
      "visual": "대화 중단 시간선과 이동을 멈추고 대화 시작하는 시간선을 대비.",
      "narration": [
        {
          "id": "concept-2-ko",
          "lang": "ko",
          "voice": "Minsu (Enhanced)",
          "text": "스톱 뒤의 아이엔지는 하던 행동을 멈춘다는 뜻이에요. 투와 원형은 다른 행동을 하려고 멈췄다는 목적이죠.",
          "actualStart": 10.628574599999999,
          "actualEnd": 18.057690599999997,
          "rate": 185,
          "cacheKey": "6b960f3f8553f5dc627dfaa6ceec55e70822713fc511e89345e7d3c59ebcaeee",
          "file": "audio/12/concept-2-ko-6b960f3f8553f5dc.wav",
          "duration": 7.429116
        }
      ],
      "plannedStart": 10,
      "plannedEnd": 20
    },
    {
      "id": "concept-3",
      "kind": "concept",
      "start": 20.3049952,
      "end": 29.566313800000003,
      "text": "리멤버 뒤의 아이엔지는 이미 한 일을 기억하는 뜻이에요. 투와 원형은 해야 할 일을 잊지 않고 한다는 뜻이죠.",
      "screen": "remember locking / remember to lock",
      "visual": "잠금 행동 뒤 회상과 기억 뒤 잠금 행동의 순서를 반대로 배치.",
      "narration": [
        {
          "id": "concept-3-ko",
          "lang": "ko",
          "voice": "Minsu (Enhanced)",
          "text": "리멤버 뒤의 아이엔지는 이미 한 일을 기억하는 뜻이에요. 투와 원형은 해야 할 일을 잊지 않고 한다는 뜻이죠.",
          "actualStart": 20.5049952,
          "actualEnd": 27.3190092,
          "rate": 185,
          "cacheKey": "b9c39cbcf8c28e2b66f23aacb37293effcb75474286b25e86fc285a04ed5d92b",
          "file": "audio/12/concept-3-ko-b9c39cbcf8c28e2b.wav",
          "duration": 6.814014
        }
      ],
      "plannedStart": 20,
      "plannedEnd": 30
    },
    {
      "id": "concept-4",
      "kind": "contrast",
      "start": 29.566313800000003,
      "end": 39.6250014,
      "text": "트라이 뒤의 아이엔지는 방법을 시험해 보는 쪽에, 투와 원형은 해내려 노력하는 쪽에 초점을 두는 경우가 많아요.",
      "screen": "try restarting / try to repair",
      "visual": "재시작 방법 시험 카드와 수리 목표 노력 화살표를 나란히 표시.",
      "narration": [
        {
          "id": "concept-4-ko",
          "lang": "ko",
          "voice": "Minsu (Enhanced)",
          "text": "트라이 뒤의 아이엔지는 방법을 시험해 보는 쪽에, 투와 원형은 해내려 노력하는 쪽에 초점을 두는 경우가 많아요.",
          "actualStart": 29.766313800000002,
          "actualEnd": 37.3776968,
          "rate": 185,
          "cacheKey": "3f195f83c2d7f6dfe7c878f2dd78bfc31844922b48747c5edabf4a11b6a669af",
