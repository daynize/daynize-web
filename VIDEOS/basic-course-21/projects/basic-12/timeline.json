{
  "id": "basic-12",
  "episode": 12,
  "title": "멈춘 행동과 멈춘 이유는 달라요",
  "durationTarget": 130,
  "timingStatus": "audio-measured-words-aligned",
  "voices": {
    "ko": "Minsu (Enhanced)",
