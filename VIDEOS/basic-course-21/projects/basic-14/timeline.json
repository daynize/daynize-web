{
  "id": "basic-14",
  "episode": 14,
  "title": "감정을 일으키는 쪽과 느끼는 쪽",
  "durationTarget": 130,
  "timingStatus": "audio-measured-words-aligned",
  "voices": {
    "ko": "Minsu (Enhanced)",
