{
  "id": "basic-03",
  "episode": 3,
  "title": "무엇을 주고, 누구에게 줄까요?",
  "durationTarget": 130,
  "timingStatus": "audio-measured-words-aligned",
  "voices": {
    "ko": "Jian (Premium)",
