{
  "id": "basic-06",
  "episode": 6,
  "title": "정보 두 개를 영어로 세는 법",
  "durationTarget": 130,
  "timingStatus": "audio-measured-words-aligned",
  "voices": {
    "ko": "Minsu (Enhanced)",
