          "seconds": 4.206
        }
      ],
      "file": "p2.mp3",
      "seconds": 4.206,
      "frames": 126
    },
    "s07": {
      "segments": [
        {
          "lang": "kr",
          "text": "만약 우리가 지금 서두르지 않는다면, 그 마지막 멜로디를 놓치게 될 것이다.",
          "file": "parts/s07_01_kr.mp3",
          "hash": "5c425d2a0ede41d2",
          "seconds": 5.46
        },
        {
          "lang": "en",
          "text": "Unless we hurry right now, we will miss that last melody.",
          "file": "parts/s07_02_en.mp3",
          "hash": "b2f13902a702e0b5",
          "seconds": 3.344
        }
      ],
      "file": "s07.mp3",
      "seconds": 8.96,
      "frames": 269
    },
    "s08": {
      "segments": [
        {
          "lang": "kr",
          "text": "만약 네가 용기를 내지 않는다면, 진실의 문은 절대 열리지 않을 것이다.",
          "file": "parts/s08_01_kr.mp3",
          "hash": "205ce55622f48290",
          "seconds": 6.087
        },
        {
          "lang": "en",
          "text": "Unless you take courage, the door of truth will never open.",
          "file": "parts/s08_02_en.mp3",
          "hash": "0f3c11df2215ed9c",
          "seconds": 3.37
        }
      ],
      "file": "s08.mp3",
      "seconds": 9.613,
      "frames": 288
    },
    "s09": {
      "segments": [
        {
          "lang": "kr",
          "text": "만약 비가 내리지 않는다면, 우리는 오늘 밤 다시 그 카페 2층으로 갈 것이다.",
          "file": "parts/s09_01_kr.mp3",
          "hash": "f507b6c36fdc047a",
          "seconds": 6.087
        },
        {
          "lang": "en",
          "text": "Unless it rains, we will go back to that second-floor cafe tonight.",
          "file": "parts/s09_02_en.mp3",
          "hash": "fd03006136ff43bb",
          "seconds": 3.762
        }
      ],
      "file": "s09.mp3",
      "seconds": 9.979,
      "frames": 299
    },
    "s10": {
      "segments": [
        {
          "lang": "kr",
          "text": "만약 우리가 조용히 하지 않는다면, 도시의 정령이 순식간에 사라져 버릴지도 모른다.",
          "file": "parts/s10_01_kr.mp3",
          "hash": "4c91ef2ac0b85250",
          "seconds": 7.131
        },
        {
          "lang": "en",
          "text": "Unless we stay quiet, the spirit of the city might vanish in a second.",
          "file": "parts/s10_02_en.mp3",
          "hash": "9d124cfeac3e9ca9",
          "seconds": 3.892
        }
      ],
      "file": "s10.mp3",
      "seconds": 11.207,
      "frames": 336
    },
    "s11": {
      "segments": [
        {
          "lang": "kr",
          "text": "만약 그 음악이 멈추지 않는다면, 우리는 밤새 그 골목에 머물게 될 것이다.",
          "file": "parts/s11_01_kr.mp3",
          "hash": "a0b4edb9ab92d234",
          "seconds": 6.165
        },
        {
          "lang": "en",
          "text": "Unless the music stops, we will stay in that alley all night long.",
          "file": "parts/s11_02_en.mp3",
          "hash": "0a367a3130a0bf06",
          "seconds": 3.579
        }
      ],
      "file": "s11.mp3",
      "seconds": 9.9,
      "frames": 297
    },
    "s12": {
      "segments": [
        {
          "lang": "kr",
          "text": "만약 네가 비밀을 지키지 않는다면, 다시는 이 마법 같은 경험을 할 수 없을 것이다.",
          "file": "parts/s12_01_kr.mp3",
          "hash": "35b4efa3dcbc21f5",
          "seconds": 6.922
        },
        {
          "lang": "en",
          "text": "Unless you keep the secret, you will never experience this magic again.",
