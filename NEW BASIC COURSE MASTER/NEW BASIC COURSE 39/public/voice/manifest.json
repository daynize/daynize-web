      "file": "s09.mp3",
      "seconds": 13.061,
      "frames": 392
    },
    "s10": {
      "segments": [
        {
          "lang": "kr",
          "text": "이제 우리는 각자의 일상으로 돌아가지만, 우리의 언어는 이전보다 훨씬 더 풍성해졌다.",
          "file": "parts/s10_01_kr.mp3",
          "hash": "35f5b1af8bb5c93a",
          "seconds": 7.34
        },
        {
          "lang": "en",
          "text": "Now we return to our daily lives, but our language has become much richer than before.",
