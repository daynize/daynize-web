          "hash": "4f3ba92062ac7aa8",
          "seconds": 4.911
        }
      ],
      "file": "s10.mp3",
      "seconds": 12.408,
      "frames": 372
    },
    "s11": {
      "segments": [
        {
          "lang": "kr",
          "text": "만약 네가 다시 영어 문장을 세우고 싶다면, 언제든 이 도심 동화의 골목길로 찾아오면 된다.",
          "file": "parts/s11_01_kr.mp3",
          "hash": "45a196bf8b59ee85",
          "seconds": 7.131
        },
        {
          "lang": "en",
          "text": "If you want to build English sentences again, you can always visit this alley of urban fairy tale.",
          "file": "parts/s11_02_en.mp3",
          "hash": "f0a3597e7243d4fd",
          "seconds": 4.963
        }
      ],
      "file": "s11.mp3",
