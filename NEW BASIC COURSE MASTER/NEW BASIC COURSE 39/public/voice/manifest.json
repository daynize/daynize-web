          "hash": "54888a69c7c224bb",
          "seconds": 4.911
        }
      ],
      "file": "s08.mp3",
      "seconds": 10.919,
      "frames": 328
    },
    "s09": {
      "segments": [
        {
          "lang": "kr",
          "text": "카페 2층의 불빛은 꺼졌지만, 그 울림은 우리의 가슴속에 영원히 꺼지지 않을 것이다.",
          "file": "parts/s09_01_kr.mp3",
          "hash": "3665ffc5fc4a8def",
          "seconds": 7.784
        },
        {
          "lang": "en",
          "text": "Though the light on the second floor went out, its echo will never fade in our hearts.",
