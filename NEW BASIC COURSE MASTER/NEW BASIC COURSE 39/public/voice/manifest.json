          "hash": "ee1b20c6c2387358",
          "seconds": 4.441
        }
      ],
      "file": "p2.mp3",
      "seconds": 4.441,
      "frames": 133
    },
    "s08": {
      "segments": [
        {
          "lang": "kr",
          "text": "오래된 일기장 마지막 페이지에 적힌 문장은 우리 모두에게 전하는 희망의 메시지였다.",
          "file": "parts/s08_01_kr.mp3",
          "hash": "9a9c91bf055e4e1d",
          "seconds": 5.851
        },
        {
          "lang": "en",
          "text": "The sentence written on the last page of the old diary was a message of hope to us all.",
