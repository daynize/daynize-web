      "file": "s04.mp3",
      "seconds": 8.934,
      "frames": 268
    },
    "s05": {
      "segments": [
        {
          "lang": "kr",
          "text": "우리는 오래된 일기장을 챙겼고, 조용히 카페 2층을 내려왔다.",
