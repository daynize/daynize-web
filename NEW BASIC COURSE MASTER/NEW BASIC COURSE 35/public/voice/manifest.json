        }
      ],
      "file": "s07.mp3",
      "seconds": 7.027,
      "frames": 211
    },
    "s08": {
      "segments": [
        {
          "lang": "kr",
          "text": "자정이 되었을 때가 바로 모든 네온사인이 빛나기 시작한 순간이다.",
          "file": "parts/s08_01_kr.mp3",
          "hash": "50cd02692b617cc0",
          "seconds": 4.911
        },
        {
          "lang": "en",
          "text": "Midnight is the time when all the neon signs started to shine.",
