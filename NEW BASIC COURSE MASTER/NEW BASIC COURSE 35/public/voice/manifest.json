      "file": "s08.mp3",
      "seconds": 8.542,
      "frames": 256
    },
    "s09": {
      "segments": [
        {
          "lang": "kr",
          "text": "이것이 그 피아니스트가 매일 밤 홀로 연주했던 이유이다.",
