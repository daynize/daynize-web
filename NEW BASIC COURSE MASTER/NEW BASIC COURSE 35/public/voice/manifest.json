          "seconds": 4.362
        }
      ],
      "file": "a1.mp3",
      "seconds": 4.362,
      "frames": 131
    },
    "a2": {
      "segments": [
        {
          "lang": "kr",
          "text": "벗, 하지만, 그러나. 앞뒤 내용의 반전입니다.",
