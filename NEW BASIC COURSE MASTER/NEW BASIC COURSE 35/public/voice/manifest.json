      "file": "s05.mp3",
      "seconds": 9.9,
      "frames": 297
    },
    "s06": {
      "segments": [
        {
          "lang": "kr",
          "text": "그 음악이 내 마음을 울렸기 때문에, 나는 발걸음을 멈출 수밖에 없었다.",
