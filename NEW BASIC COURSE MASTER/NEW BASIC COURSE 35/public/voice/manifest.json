      "file": "s06.mp3",
      "seconds": 9.953,
      "frames": 299
    },
    "s07": {
      "segments": [
        {
          "lang": "kr",
          "text": "이곳은 우리가 비밀 피아노 소리를 들었던 그 장소이다.",
